# ============ LLM 配置（M2 问答接口才使用，M1 可先不填） ============

# 默认走 DeepSeek API
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的Key
LLM_MODEL=deepseek-chat

# 想切到本地 Ollama 模型（你机器上装的是 qwen3:8b）时，把上面四行改成下面三行即可：
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# ============ Embedding ============

# 本地已有 bge-m3（Ollama 版，GGUF 格式），默认走 Ollama API，无需下载模型。
# 使用前提：Ollama 服务已启动（任务栏右下角有 Ollama 图标）
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# 若想改用 HuggingFace 格式的 bge-m3（本地目录或自动下载）：
# EMBED_PROVIDER=sentence_transformers
# EMBED_MODEL=BAAI/bge-m3
# EMBED_MODEL=D:\models\bge-m3    # 本地已有 HF 目录时填路径
# 下载慢/失败时（Windows PowerShell）：
#   $env:HF_ENDPOINT="https://hf-mirror.com"
